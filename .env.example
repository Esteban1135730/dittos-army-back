PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/ditto-army
EUR_TO_COP=5000
USD_TO_COP=4500
EXCHANGE_EUR_TO_COP=4500
EXCHANGE_USD_TO_COP=4000
STORE_INVENTORY_PATH=./tmp/store-inventory.txt
STORE_UPCOMING_PATH=./tmp/store-upcoming.txt

# Factus sandbox v2 (https://api-sandbox.factus.com.co)
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
# Opcion A: OAuth (recomendado; el back renueva el token)
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
# Opcion B: token fijo (expira ~1h); deja OAuth vacio si usas esto
FACTUS_API_TOKEN=
# Rango "Factura de Venta" en sandbox (listar con GET /v2/numbering-ranges)
FACTUS_NUMBERING_RANGE_ID=389
FACTUS_IVA_RATE=19.00
CORS_ALLOW_ONRENDER=true
